+/**
+ * The pose the *sprite* plays, which is not always the semantic state.
+ *
+ * A busy turn resolves to `run`, i.e. the in-place run cycle — legs pumping while
+ * the mascot goes nowhere, which reads as jogging on the spot rather than "she's
+ * working on it". She sits and waits instead (`waiting`); it's the calm, correct
+ * read for a maid watching her master's work finish. `$petState` itself is left
+ * alone so the bubble keeps saying "heads down…" and the roam loop (which sets
+ * `$petMotion`) still walks.
+ */
+export const $petPose = computed([$petState, $petMotion], (state, motion): PetState =>
+  state === 'run' && !motion ? 'waiting' : state
